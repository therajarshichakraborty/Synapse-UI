{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-shell",
  "type": "registry:block",
  "meta": {
    "category": "block"
  },
  "dependencies": [
    "lucide-react",
    "recharts"
  ],
  "registryDependencies": [
    "https://synapse-ui-dev.vercel.app/r/avatar.json",
    "https://synapse-ui-dev.vercel.app/r/badge.json",
    "https://synapse-ui-dev.vercel.app/r/button.json",
    "https://synapse-ui-dev.vercel.app/r/card.json",
    "https://synapse-ui-dev.vercel.app/r/chart.json",
    "https://synapse-ui-dev.vercel.app/r/input.json",
    "https://synapse-ui-dev.vercel.app/r/separator.json",
    "https://synapse-ui-dev.vercel.app/r/sidebar.json"
  ],
  "files": [
    {
      "path": "components/synapse-ui/dashboard-shell.tsx",
      "target": "components/synapse-ui/dashboard-shell.tsx",
      "type": "registry:component",
      "content": "\"use client\";\n\nimport {\n  BarChart3Icon,\n  BellIcon,\n  CreditCardIcon,\n  HomeIcon,\n  SearchIcon,\n  SettingsIcon,\n  TrendingUpIcon,\n  UsersIcon,\n} from \"lucide-react\";\nimport { Area, AreaChart, CartesianGrid, XAxis } from \"recharts\";\nimport { Avatar, AvatarFallback } from \"@/components/synapse-ui/avatar\";\nimport { Badge } from \"@/components/synapse-ui/badge\";\nimport { Button } from \"@/components/synapse-ui/button\";\nimport {\n  Card,\n  CardAction,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/synapse-ui/card\";\nimport {\n  ChartContainer,\n  ChartTooltip,\n  ChartTooltipContent,\n  type ChartConfig,\n} from \"@/components/synapse-ui/chart\";\nimport { Input } from \"@/components/synapse-ui/input\";\nimport { Separator } from \"@/components/synapse-ui/separator\";\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarFooter,\n  SidebarGroup,\n  SidebarGroupContent,\n  SidebarGroupLabel,\n  SidebarHeader,\n  SidebarInset,\n  SidebarMenu,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarProvider,\n  SidebarTrigger,\n} from \"@/components/synapse-ui/sidebar\";\n\nconst nav = [\n  { title: \"Overview\", icon: HomeIcon, active: true },\n  { title: \"Analytics\", icon: BarChart3Icon },\n  { title: \"Customers\", icon: UsersIcon },\n  { title: \"Billing\", icon: CreditCardIcon },\n];\n\nconst stats = [\n  { label: \"Revenue\", value: \"$45,231\", delta: \"+20.1%\" },\n  { label: \"Subscriptions\", value: \"2,350\", delta: \"+180\" },\n  { label: \"Active now\", value: \"573\", delta: \"+12%\" },\n  { label: \"Churn\", value: \"1.2%\", delta: \"-0.4%\" },\n];\n\nconst data = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\"].map((m, i) => ({\n  month: m,\n  revenue: 2000 + i * 600 + (i % 3) * 900,\n}));\nconst config = { revenue: { label: \"Revenue\", color: \"var(--chart-1)\" } } satisfies ChartConfig;\n\nexport default function DashboardShell() {\n  return (\n    <SidebarProvider>\n      <Sidebar collapsible=\"icon\" variant=\"inset\">\n        <SidebarHeader>\n          <SidebarMenu>\n            <SidebarMenuItem>\n              <SidebarMenuButton size=\"lg\">\n                <span className=\"flex size-8 items-center justify-center rounded-lg bg-primary text-sm font-semibold text-primary-foreground\">\n                  A\n                </span>\n                <span className=\"grid text-left text-sm leading-tight\">\n                  <span className=\"font-semibold\">Acme Inc</span>\n                  <span className=\"text-xs text-muted-foreground\">Enterprise</span>\n                </span>\n              </SidebarMenuButton>\n            </SidebarMenuItem>\n          </SidebarMenu>\n        </SidebarHeader>\n        <SidebarContent>\n          <SidebarGroup>\n            <SidebarGroupLabel>Dashboard</SidebarGroupLabel>\n            <SidebarGroupContent>\n              <SidebarMenu>\n                {nav.map((n) => (\n                  <SidebarMenuItem key={n.title}>\n                    <SidebarMenuButton isActive={n.active} tooltip={n.title}>\n                      <n.icon />\n                      <span>{n.title}</span>\n                    </SidebarMenuButton>\n                  </SidebarMenuItem>\n                ))}\n              </SidebarMenu>\n            </SidebarGroupContent>\n          </SidebarGroup>\n        </SidebarContent>\n        <SidebarFooter>\n          <SidebarMenu>\n            <SidebarMenuItem>\n              <SidebarMenuButton tooltip=\"Settings\">\n                <SettingsIcon />\n                <span>Settings</span>\n              </SidebarMenuButton>\n            </SidebarMenuItem>\n          </SidebarMenu>\n        </SidebarFooter>\n      </Sidebar>\n      <SidebarInset>\n        <header className=\"flex h-14 items-center gap-2 border-b border-border px-4\">\n          <SidebarTrigger />\n          <Separator orientation=\"vertical\" className=\"h-4\" />\n          <span className=\"text-sm font-medium\">Overview</span>\n          <div className=\"ml-auto flex items-center gap-2\">\n            <div className=\"relative hidden sm:block\">\n              <SearchIcon className=\"absolute top-1/2 left-2.5 size-4 -translate-y-1/2 text-muted-foreground\" />\n              <Input placeholder=\"Search...\" aria-label=\"Search\" className=\"h-8 w-56 pl-8\" />\n            </div>\n            <Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"Notifications\">\n              <BellIcon />\n            </Button>\n            <Avatar size=\"sm\">\n              <AvatarFallback>AL</AvatarFallback>\n            </Avatar>\n          </div>\n        </header>\n        <main className=\"grid gap-4 p-4 md:p-6\">\n          <div className=\"grid gap-4 sm:grid-cols-2 xl:grid-cols-4\">\n            {stats.map((s) => (\n              <Card key={s.label} size=\"sm\">\n                <CardHeader>\n                  <CardDescription>{s.label}</CardDescription>\n                  <CardTitle className=\"text-2xl tabular-nums\">{s.value}</CardTitle>\n                  <CardAction>\n                    <Badge variant={s.delta.startsWith(\"-\") ? \"secondary\" : \"success\"}>\n                      <TrendingUpIcon data-icon=\"inline-start\" />\n                      {s.delta}\n                    </Badge>\n                  </CardAction>\n                </CardHeader>\n              </Card>\n            ))}\n          </div>\n          <Card>\n            <CardHeader>\n              <CardTitle>Revenue</CardTitle>\n              <CardDescription>January to August</CardDescription>\n            </CardHeader>\n            <CardContent>\n              <ChartContainer config={config} className=\"h-[260px] w-full\">\n                <AreaChart accessibilityLayer data={data}>\n                  <defs>\n                    <linearGradient id=\"dash-fill\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                      <stop offset=\"5%\" stopColor=\"var(--color-revenue)\" stopOpacity={0.45} />\n                      <stop offset=\"95%\" stopColor=\"var(--color-revenue)\" stopOpacity={0} />\n                    </linearGradient>\n                  </defs>\n                  <CartesianGrid vertical={false} />\n                  <XAxis dataKey=\"month\" tickLine={false} axisLine={false} tickMargin={8} />\n                  <ChartTooltip content={<ChartTooltipContent indicator=\"line\" />} />\n                  <Area\n                    isAnimationActive={false}\n                    dataKey=\"revenue\"\n                    type=\"natural\"\n                    stroke=\"var(--color-revenue)\"\n                    strokeWidth={2}\n                    fill=\"url(#dash-fill)\"\n                  />\n                </AreaChart>\n              </ChartContainer>\n            </CardContent>\n          </Card>\n        </main>\n      </SidebarInset>\n    </SidebarProvider>\n  );\n}\n"
    }
  ]
}